#include<stdio.h>

int main()
{
	int arr[]={1,2,3,4,5};
	int firstVal, secondVal, i;
	int size=sizeof(arr)/sizeof(arr[0]);
	
	for(i=0; i<size/2; i++)
	{
		firstVal=arr[i];
		secondVal=arr[size-i-1];
		arr[i]=secondVal;
		arr[size-i-1]=firstVal;
	}
	
	for(i=0; i<size; i++)
	{
		printf("%d\t", arr[i]);
	}
	printf("\n");

  return 0;
}
