#include<stdio.h>

//call by reference
int sum(int *a, int *b)
{
	int sum=0;
	sum=(*a)+(*b);
}


int pro(int *a, int *b)
{
	int pro=1;
	pro=(*a)*(*b);
}



int main()
{
	int i=5, j=3;
	
	printf("Sum=%d\n", sum(&i, &j)); 
	printf("Product=%d\n", pro(&i, &j)); 
	printf("Average=%d", (sum(&i, &j))/2); 
	
	return 0;
}  
