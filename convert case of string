#include<stdio.h>
#include<string.h>

int main()
{
	char str[100];
	int ch;
	
	
	printf("Enter a string:");
	scanf("%s", str);		//taking the string input from user
	
	printf("Original string: %s\n", str); 
	
	int len=strlen(str);
	
	printf("Enter choice: 1 to uppercase & 2 to lowercase:");
	scanf("%d", &ch);	//taking choice from user
	
	switch(ch)
	{
		case 1:  	// convert to lowercase
		{
		
				for(int i=0; i<len; i++)
			{
				if(str[i]>='A'&& str[i]<='Z')
			{
				str[i] = str[i] +32;
			}
			}
				printf("String in lower case: %s", str);
		
		}
				break;
		
		case 2:		//convert to uppercase
		{
			
				for(int i=0; i<len; i++)
			{
				if(str[i]>='a'&& str[i]<='z')
			{
				str[i] = str[i] - 32;
			}
			}
				printf("String in upper case: %s", str);
		
		}
				break;
}
	
	
	return 0;
}
	

