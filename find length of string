#include<stdio.h>

int countLength(char arr[]);

int countLength(char arr[])		//function definition
{
	int count=0;
	
	for(int i=0;arr[i]!='\0'; i++)
	{
		count++;	
	}
	return count;
}

int main()
{
	char name[100];
	
  printf("Enter your name:");
	scanf("%s", name);
	
printf("%d", countLength(name));	//function call
}

