#include<stdio.h>


int main()
{
	int arr[2][10];
	int i=0, j=0;
	
	for(i=0; i<2; i++)
	{
		for(j=0; j<10; j++)
		{
			arr[i][j]=j+1;
		}
	}
	
	for(i=0; i<1; i++)
	{
			for(j=0; j<10; j++)
		{
				printf("%d ",(arr[i][j])*2);
		}
		printf("\n");
	}
	for(i=1; i<2; i++)
	{
			for(j=0; j<10; j++)
		{
				printf("%d ",(arr[i][j])*3);
		}
		printf("\n");
	}
	
	return 0;
}  
