#include<stdio.h>


int main()
{
	int arr[3][3];
	int i=0, j=0;
	
	printf("Enter elements of 2D array:");
	
	for(i=0; i<3; i++)
	{
			for(j=0; j<3; j++)
		{
				scanf("%d",&arr[i][j]);
		}
	}
	for(i=0; i<3; i++)
	{
			for(j=0; j<3; j++)
		{
				printf("%d",arr[i][j]);
		}
		printf("\n");
	}
	
	return 0;
}  
