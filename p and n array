#include<stdio.h>

int main()
{
	int arr[50]={1,2,3,4,-8,-6,-4-3};
	int i;
	int p[50], n[50];
	int pCount=0, nCount=0;
	
	int size=sizeof(arr)/sizeof(arr[0]);
	
	for(i=0; i<size;i++)
	{
		if(arr[i]<0)
		{
			n[nCount]=arr[i];
			nCount++;
			
		}
		else if(arr[i]>0)
		{
			p[pCount]=arr[i];
			pCount++;
			
		}
	
}
	
	printf("Positive array:");
	for(i=0; i<pCount; i++)
	{
		printf("%d ", p[i]);
	}
	printf("\n");
	
	printf("Negative array:");
	for(i=0; i<nCount; i++)
	{
		printf("%d ", n[i]);
	}
	printf("\n");
	
	return 0;
}
