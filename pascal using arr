#include<stdio.h>

int main()
{
	int m[5][5], i, j;
	
	for(i=0;i<5;i++)
	{
		for(j=0; j<=i; j++)
		{
			if(j==0||j==i)
			{
				m[i][j]=1;
			}
			else
			{
				m[i][j]=m[i-1][j-1]+m[i-1][j];
			}
		}
	}
	for(i=0; i<5; i++)
	{
		for(j=0; j<(5-i-1); j++)
		{
			printf("  ");
		}
	
		for(j=0; j<=i; j++)
		{
			printf("%6d", m[i][j]);
		}
		printf("\n");
	}

}
